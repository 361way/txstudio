# VodStudio SaaS 后端配置
# 复制为 config.yaml 并填入真实值

server:
  port: 8080
  mode: debug          # debug | release

database:
  host: 127.0.0.1
  port: 3306
  user: vodstudio
  password: changeme
  dbname: vodstudio
  charset: utf8mb4

jwt:
  secret: change-this-to-a-random-64-char-string
  access_ttl: 15m      # access token 有效期
  refresh_ttl: 168h    # refresh token 有效期 (7天)

# AES-256-GCM 加密凭证用，32 字节 hex（64 个字符）
crypto:
  aes_key: 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 腾讯云 COS（资产存储）
cos:
  secret_id: ""
  secret_key: ""
  region: ap-guangzhou
  bucket: vodstudio-1250000000
  # 资产按 tenant 前缀隔离：{bucket}/{cos_prefix}/{tenantId}/...
  cos_prefix: assets
  # 临时上传 URL 有效期
  presign_ttl: 10m
