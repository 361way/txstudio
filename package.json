{
  "name": "txstudio",
  "private": true,
  "version": "v1.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && go run ./cmd/server -config config.yaml -open=false",
    "dev:frontend": "vite",
    "build:web": "vite build",
    "build": "npm run build:web && node scripts/sync-frontend.mjs",
    "build:binary": "node scripts/build-release.mjs",
    "test:standalone": "node scripts/smoke-standalone.mjs",
    "preview": "vite preview",
    "test": "cd backend && go test ./..."
  },
  "dependencies": {
    "dompurify": "^3.0.8",
    "file-saver": "^2.0.5",
    "i18next": "^23.12.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.344.0",
    "marked": "^12.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.4",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4",
    "vite-plugin-singlefile": "^2.0.1"
  }
}
